rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if caller is an administrator
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'msal209m@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'ADMIN'])
      );
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }

    // License Keys collection security rules
    match /license_keys/{keyId} {
      allow list, create, delete: if isAdmin();
      allow get: if request.auth != null;
      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.is_used == false &&
        request.resource.data.is_used == true &&
        request.resource.data.used_by == request.auth.uid
      );
    }

    // User profiles & multi-tenant personal storage
    match /users/{userId} {
      allow read, write: if true;
      
      match /items/{itemId} {
        allow read, write: if true;
      }
      
      match /transactions/{transactionId} {
        allow read, write: if true;
      }
      
      match /debts/{debtId} {
        allow read, write: if true;
      }
      
      match /settings/{settingsId} {
        allow read, write: if true;
      }

      match /cashiers/{cashierId} {
        allow read, write: if true;
      }

      match /backups/{backupId} {
        allow read, write: if true;
      }

      match /activity_logs/{logId} {
        allow read, write: if true;
      }
    }

    // Public Village Stores Directory (Browsing stores by village)
    match /stores/{storeId} {
      allow read, write: if true;
      
      match /items/{itemId} {
        allow read, write: if true;
      }
    }

    // Merchants directory & sync across all devices
    match /merchants/{merchantId} {
      allow read, write: if true;
    }

    // Drivers directory & sync across all devices
    match /drivers/{driverId} {
      allow read, write: if true;
    }

    // Customers directory & profiles
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Advertisements (Village bulletin & sponsored ads)
    match /ads/{adId} {
      allow read, write: if true;
    }

    // Orders collection: Customers, Merchants, and Drivers can access and sync orders in real-time
    match /delivery_orders/{orderId} {
      allow read, write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
