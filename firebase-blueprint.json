{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Village grocery or store record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerName": { "type": "string" },
        "phone": { "type": "string" },
        "cityOrVillage": { "type": "string" },
        "status": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "itemsCount": { "type": "number" }
      },
      "required": ["id", "name", "cityOrVillage"]
    },
    "Item": {
      "title": "Item",
      "description": "Store product item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "barcode": { "type": "string" },
        "salePrice": { "type": "number" },
        "costPrice": { "type": "number" },
        "quantity": { "type": "number" },
        "unit": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "imageUrl": { "type": "string" },
        "available": { "type": "boolean" },
        "storeId": { "type": "string" },
        "merchantId": { "type": "string" }
      },
      "required": ["id", "name", "salePrice"]
    },
    "Merchant": {
      "title": "Merchant",
      "description": "Registered merchant account record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "nationalId": { "type": "string" },
        "storeName": { "type": "string" },
        "village": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phone", "storeName", "village"]
    },
    "Driver": {
      "title": "Driver",
      "description": "Registered delivery driver record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "nationalId": { "type": "string" },
        "vehicleType": { "type": "string" },
        "zone": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phone"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Registered customer account record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "nationalId": { "type": "string" },
        "village": { "type": "string" },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "phone"]
    },
    "DeliveryOrder": {
      "title": "DeliveryOrder",
      "description": "Marketplace delivery order record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "storeId": { "type": "string" },
        "storeName": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "status": { "type": "string" },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "customerName", "status"]
    },
    "Ad": {
      "title": "Ad",
      "description": "Village marketplace advertisement record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "village": { "type": "string" }
      },
      "required": ["id", "title"]
    },
    "LicenseKey": {
      "title": "LicenseKey",
      "description": "Activation license key",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "is_used": { "type": "boolean" }
      },
      "required": ["key", "is_used"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile metadata",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["email", "displayName"]
    }
  },
  "firestore": {
    "/stores/{storeId}": {
      "schema": "Store",
      "description": "Public village stores directory"
    },
    "/stores/{storeId}/items/{itemId}": {
      "schema": "Item",
      "description": "Store inventory products subcollection"
    },
    "/merchants/{merchantId}": {
      "schema": "Merchant",
      "description": "Central merchants registry collection"
    },
    "/drivers/{driverId}": {
      "schema": "Driver",
      "description": "Central drivers registry collection"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Central customers registry collection"
    },
    "/delivery_orders/{orderId}": {
      "schema": "DeliveryOrder",
      "description": "Central delivery orders collection"
    },
    "/ads/{adId}": {
      "schema": "Ad",
      "description": "Advertisements collection"
    },
    "/license_keys/{keyId}": {
      "schema": "LicenseKey",
      "description": "Activation license keys collection"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    }
  }
}
