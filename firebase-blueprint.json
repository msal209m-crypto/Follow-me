{
  "entities": {
    "Merchant": {
      "title": "Merchant Account",
      "description": "Professional account details for store owners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "pattern": "^\\+?[0-9]{8,15}$" },
        "nationalId": { "type": "string", "minLength": 8, "maxLength": 20 },
        "storeName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "village": { "type": "string", "minLength": 2, "maxLength": 100 },
        "isApproved": { "type": "boolean" },
        "kycStatus": { "type": "string", "enum": ["PENDING_REVIEW", "VERIFIED", "REJECTED"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "nationalId", "storeName", "village", "isApproved"]
    },
    "Driver": {
      "title": "Delivery Driver",
      "description": "Account details for delivery personnel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "pattern": "^\\+?[0-9]{8,15}$" },
        "nationalId": { "type": "string", "minLength": 8, "maxLength": 20 },
        "vehicleInfo": { "type": "string", "maxLength": 200 },
        "isApproved": { "type": "boolean" },
        "status": { "type": "string", "enum": ["PENDING", "ACTIVE", "SUSPENDED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "nationalId", "isApproved", "status"]
    },
    "Customer": {
      "title": "Platform Customer",
      "description": "Details for users buying from stores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "pattern": "^\\+?[0-9]{8,15}$" },
        "nationalId": { "type": "string", "minLength": 8, "maxLength": 20 },
        "village": { "type": "string", "minLength": 2, "maxLength": 100 },
        "isApproved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "phone", "nationalId", "village", "isApproved"]
    },
    "Order": {
      "title": "Delivery Order",
      "description": "Operational order records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "merchantId": { "type": "string" },
        "driverId": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "ACCEPTED", "PREPARING", "READY", "PICKED_UP", "DELIVERED", "CANCELLED"] },
        "total": { "type": "number", "minimum": 0 },
        "items": { "type": "array" },
        "village": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "merchantId", "status", "total", "items", "village"]
    },
    "Item": {
      "title": "Store Product",
      "description": "Inventory items for a specific store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "barcode": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string" },
        "quantity": { "type": "number" },
        "costPrice": { "type": "number" },
        "salePrice": { "type": "number" },
        "merchantId": { "type": "string" },
        "storeId": { "type": "string" }
      },
      "required": ["id", "name", "quantity", "costPrice", "salePrice", "merchantId"]
    }
  },
  "firestore": {
    "/merchants/{merchantId}": {
      "schema": "Merchant",
      "description": "Merchant profiles"
    },
    "/drivers/{driverId}": {
      "schema": "Driver",
      "description": "Driver profiles"
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customer profiles"
    },
    "/delivery_orders/{orderId}": {
      "schema": "Order",
      "description": "Platform delivery orders"
    },
    "/stores/{storeId}/items/{itemId}": {
      "schema": "Item",
      "description": "Inventory products per store"
    }
  }
}
